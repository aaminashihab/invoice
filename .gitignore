# ==============================================================================
# CIV (Construction Invoice Verification) Root Git Ignore
# ==============================================================================

# Environment files & Secrets (Strictly Excluded)
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
*.env
*.env.*

# Allow safe example and template files ONLY
!.env.example
!*.env.example
!backend/.env.example
!.env.pilot.template
!deploy/.env.pilot.template

# Backups & Database Dumps (Must Remain Local)
*.dump
*.bak
*.backup
deploy/backups/
backups/

# Databases & Persistence Data
*.db
*.db.bak
*.sqlite
*.sqlite3
*.sqlite-journal
*.db-journal
civ_prototype.db
postgres_data/

# Document Storage & Uploaded Files (Local Partitions)
/storage/
backend/storage/clean/*
!backend/storage/clean/.gitkeep
backend/storage/quarantine/*
!backend/storage/quarantine/.gitkeep
backend/storage/documents/*
!backend/storage/documents/.gitkeep
!backend/storage/documents/synthetic_*
!backend/app/storage/

# Certificates, Keys & PKI
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
.caddy/
caddy_data/
caddy_config/

# Python Artifacts & Environments
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
backend/.venv/
env/
venv/
ENV/

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# Testing, Coverage & Caches
.pytest_cache/
backend/.pytest_cache/
.ruff_cache/
backend/.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
backend/.hypothesis/

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
