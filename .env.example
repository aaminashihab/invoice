# ==============================================================================
# CIV (Construction Invoice Verification) Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or 'backend/.env' for local development / testing.
# Replace all placeholder values with secure, instance-specific secrets.
# NEVER COMMIT THE POPULATED '.env' FILE TO SOURCE CONTROL.
# ==============================================================================

# Core Application Environment ('test', 'dev', 'pilot', 'production')
APP_ENV=dev

# Simulated Identities (allowed ONLY in dev/test; MUST be false in pilot/production)
DEV_IDENTITY_ENABLED=true

# Host & Port Binding
HOST=127.0.0.1
PORT=8000

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection (SQLite for local dev, PostgreSQL for pilot/production)
# For local dev SQLite:
DATABASE_URL=sqlite:///./civ_prototype.db
# For PostgreSQL:
# DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/<DB_NAME>

# PostgreSQL Service Credentials (Docker / Production)
POSTGRES_DB=civ_database
POSTGRES_USER=civ_user
POSTGRES_PASSWORD=<CHANGE_ME_DATABASE_PASSWORD>

# Cryptographic Secrets (Cryptographically random, min 32 chars)
JWT_SECRET_KEY=<CHANGE_ME_GENERATE_RANDOM_32_CHAR_JWT_SECRET>
STORAGE_ENCRYPTION_KEY=<CHANGE_ME_GENERATE_DISTINCT_RANDOM_32_CHAR_STORAGE_KEY>

# Token Expiry Lifetimes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=8

# ClamAV Anti-Malware Service
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
REQUIRE_MALWARE_SCAN=false

# Trusted Reverse Proxy IPs (Caddy loopback proxy)
FORWARDED_ALLOW_IPS=127.0.0.1
