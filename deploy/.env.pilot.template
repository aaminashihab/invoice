# ==============================================================================
# CIV M4B Controlled Internal Pilot Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.pilot' or backend/.env before running pilot:
#    cp deploy/.env.pilot.template backend/.env
# 2. Replace all placeholder values marked '<CHANGE_ME_...>' with secure,
#    unique values generated for this pilot instance.
# 3. DO NOT COMMIT THE POPULATED '.env' or '.env.pilot' FILE TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Pilot Runtime Controls
# ------------------------------------------------------------------------------
# Must be 'pilot'. In pilot mode, simulated identities are forbidden and
# named-user JWT authentication is enforced.
APP_ENV=pilot

# Must be false in pilot mode. Startup strictly fails if true.
DEV_IDENTITY_ENABLED=false

# Loopback binding for the FastAPI backend process
HOST=127.0.0.1
PORT=8000

# Origin URL for CORS and frontend client communication (via Caddy TLS reverse proxy)
FRONTEND_ORIGIN=https://localhost:8443

# ------------------------------------------------------------------------------
# 2. PostgreSQL Production Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL parameters used by Docker Compose and the backend application.
# Generate a strong password (minimum 24 characters).
POSTGRES_DB=civ_pilot
POSTGRES_USER=civ_user
POSTGRES_PASSWORD=<CHANGE_ME_GENERATE_RANDOM_PASSWORD_MIN_24_CHARS>

# Full database connection string for SQLAlchemy / Alembic.
# Must NOT start with 'sqlite'.
DATABASE_URL=postgresql://civ_user:<CHANGE_ME_INSERT_POSTGRES_PASSWORD_HERE>@127.0.0.1:5432/civ_pilot

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Minimum 32 characters, cryptographically random string for signing JWT tokens.
# Startup will strictly fail if missing, blacklisted, or under 32 characters.
JWT_SECRET_KEY=<CHANGE_ME_GENERATE_32_CHAR_RANDOM_SECRET_FOR_JWT>

# Algorithm and token lifetimes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=8

# Minimum 32 characters, cryptographically random key for AES-256-GCM clean storage.
# MUST BE DISTINCT from JWT_SECRET_KEY (key separation enforced at startup).
STORAGE_ENCRYPTION_KEY=<CHANGE_ME_GENERATE_DISTINCT_32_CHAR_SECRET_FOR_STORAGE>

# ------------------------------------------------------------------------------
# 4. ClamAV Anti-Malware Daemon Configuration
# ------------------------------------------------------------------------------
# ClamAV daemon is mandatory for pilot document uploads.
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
REQUIRE_MALWARE_SCAN=true

# ------------------------------------------------------------------------------
# 5. Reverse Proxy / TLS Termination Configuration
# ------------------------------------------------------------------------------
# Trusted proxy IP for X-Forwarded-* headers (Caddy loopback proxy)
FORWARDED_ALLOW_IPS=127.0.0.1
